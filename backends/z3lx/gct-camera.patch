+namespace detail {
+struct PoseObserverState final {
+    mmh::Hook<void, void*> hook;
+    void (*original)(void*) = nullptr;
+    mmh::Hook<void, void*, const void*> positionHook, rotationHook;
+    mmh::Hook<void, void*> cameraFlagsHook;
+    void (*positionOriginal)(void*, const void*) = nullptr;
+    void (*rotationOriginal)(void*, const void*) = nullptr;
+    void (*cameraFlagsOriginal)(void*) = nullptr;
+    std::atomic_flag samplesLock = ATOMIC_FLAG_INIT;
+    std::atomic<std::uint64_t> calls { 0 };
+    std::atomic<std::uint64_t> contentionDrops { 0 };
+    std::uint64_t capacityDrops = 0; // guarded by samplesLock
+    std::array<Entry, 64> entries {};
+    std::ofstream log;
+    LONGLONG frequency = 0;
+    LONGLONG started = 0;
+    LONGLONG lastFlush = 0;
+    std::uint64_t lastCalls = 0;
+    bool observing = false; // worker thread only
+    bool logFailed = false;
+#if defined(GCT_NATIVE_ARGUMENT_TRIAL)
+    NativeArgumentTrial argumentTrial;
+    LONGLONG lastTrialPoll = 0;
+    LONGLONG lastTrialIoLog = 0;
+    std::uint64_t trialIoFailures = 0;
+#endif
+#if defined(GCT_NATIVE_POSE_EXPERIMENT)
+    // This does NOT establish a camera identity: explicit session-scoped
+    // selection, short-lived opt-in, and an isolated build are required.
+    struct Request {
+        std::uintptr_t owner = 0;
+        DWORD thread = 0;
+        float dx = 0;
+        LONGLONG expiresQpc = 0;
+    } request;
+    std::atomic_flag requestLock = ATOMIC_FLAG_INIT;
+    std::atomic_flag mutationLock = ATOMIC_FLAG_INIT;
+    std::filesystem::file_time_type requestFileTime {};
+    bool sawRequestFile = false;
+    std::atomic<std::uint64_t> applyCount { 0 };
+#endif
+};
+} // namespace detail
+
+namespace {
+std::atomic<detail::PoseObserverState*> observer { nullptr };
+thread_local unsigned callbackDepth = 0;
+thread_local TargetTrace* currentTrace = nullptr;
+
+void ObservePosition(void* target, const void* value) {
+    const DWORD lastError = GetLastError();
+    auto* state = observer.load(std::memory_order_acquire);
+    if (currentTrace) {
+        currentTrace->positionTarget = reinterpret_cast<std::uintptr_t>(target);
+        currentTrace->positionOrder = ++currentTrace->step;
+        ++currentTrace->positionCalls;
+        if (value) std::memcpy(currentTrace->position.data(), value, sizeof(float) * 3);
+    }
+#if defined(GCT_NATIVE_ARGUMENT_TRIAL)
+    NativeArgumentTrial::Ticket ticket;
+    std::array<float, 3> argumentCopy {};
+    if (currentTrace && value) {
+        ticket = state->argumentTrial.Prepare(currentTrace->owner, target, callbackDepth, currentTrace->position, argumentCopy);
+    }
+    SetLastError(lastError);
+    // The original setter consumes this call-local copy synchronously. Never
+    // patch owner+0x64, the source argument, or a retained game-object pointer.
+    state->positionOriginal(target, ticket.replaced ? argumentCopy.data() : value);
+    const DWORD originalLastError = GetLastError();
+    state->argumentTrial.Returned(ticket);
+    SetLastError(originalLastError);
+#else
+    SetLastError(lastError);
+    state->positionOriginal(target, value);
+#endif
+}
+
+void ObserveRotation(void* target, const void* value) {
+    const DWORD lastError = GetLastError();
+    auto* state = observer.load(std::memory_order_acquire);
+    if (currentTrace) {
+        currentTrace->rotationTarget = reinterpret_cast<std::uintptr_t>(target);
+        currentTrace->rotationOrder = ++currentTrace->step;
+        ++currentTrace->rotationCalls;
+        if (value) std::memcpy(currentTrace->rotation.data(), value, sizeof(float) * 4);
+    }
+#if defined(GCT_NATIVE_ARGUMENT_TRIAL)
+    NativeArgumentTrial::Ticket ticket;
+    std::array<float, 4> argumentCopy {};
+    if (currentTrace && value) {
+        ticket = state->argumentTrial.PrepareRotation(currentTrace->owner, target, callbackDepth, currentTrace->rotation, argumentCopy);
+    }
+    SetLastError(lastError);
+    state->rotationOriginal(target, ticket.replaced ? argumentCopy.data() : value);
+    const DWORD originalLastError = GetLastError();
+    state->argumentTrial.Returned(ticket);
+    SetLastError(originalLastError);
+#else
+    SetLastError(lastError);
+    state->rotationOriginal(target, value);
+#endif
+}
+
+void ObserveCameraFlags(void* target) {
+    auto* state = observer.load(std::memory_order_acquire);
+    if (currentTrace) {
+        currentTrace->cameraTarget = reinterpret_cast<std::uintptr_t>(target);
+        currentTrace->cameraOrder = ++currentTrace->step;
+        ++currentTrace->cameraCalls;
+    }
+    state->cameraFlagsOriginal(target);
+}
+
+void RecordCompletion(detail::PoseObserverState& state, void* owner, const TargetTrace& trace) noexcept {
+    const DWORD lastError = GetLastError();
+    const DWORD thread = GetCurrentThreadId();
+    if (!state.samplesLock.test_and_set(std::memory_order_acquire)) {
+        for (auto& entry : state.entries) {
+            if (entry.count && entry.owner == reinterpret_cast<std::uintptr_t>(owner) && entry.thread == thread) {
+                ++entry.completedCalls;
+                entry.trace = trace;
+                break;
+            }
+        }
+        state.samplesLock.clear(std::memory_order_release);
+    } else state.contentionDrops.fetch_add(1, std::memory_order_relaxed);
+    SetLastError(lastError);
+}
+
+void Record(detail::PoseObserverState& state, void* owner, unsigned depth) noexcept {
+    state.calls.fetch_add(1, std::memory_order_relaxed);
+    // Never block a game thread for diagnostics. Drops remain visible in the log.
+    if (state.samplesLock.test_and_set(std::memory_order_acquire)) {
+        state.contentionDrops.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    LARGE_INTEGER now {};
+    QueryPerformanceCounter(&now);
+    const auto thread = GetCurrentThreadId();
+    const auto pointer = reinterpret_cast<std::uintptr_t>(owner);
+    bool recorded = false;
+    for (auto& entry : state.entries) {
+        if (entry.count == 0 || (entry.owner == pointer && entry.thread == thread)) {
+            if (entry.count == 0) {
+                entry.owner = pointer;
+                entry.thread = thread;
+                entry.first = now.QuadPart;
+            }
+            ++entry.count;
+            entry.last = now.QuadPart;
+            if (depth > entry.maxDepth) entry.maxDepth = depth;
+            recorded = true;
+            break;
+        }
+    }
+    if (!recorded) ++state.capacityDrops;
+    state.samplesLock.clear(std::memory_order_release);
+}
+
+#if defined(GCT_NATIVE_POSE_EXPERIMENT)
+// Deliberately NOT a FreeCam implementation. This is a five-second, one-axis,
+// single-owner native *write* experiment, currently blocked by the contract gate.
+// The dormant scope restores the source float on ordinary return/C++ unwind;
+// that is not a verified lifecycle/SEH/concurrent-writer or visual-restore contract.
+// Requests are supplied from the worker (never read files in a game callback).
+struct ScopedPoseExperiment final {
+    detail::PoseObserverState& state;
+    std::byte* field = nullptr;
+    float oldX = 0;
+    bool locked = false;
+    bool patched = false;
+
+    ScopedPoseExperiment(detail::PoseObserverState& s, void* owner, unsigned depth) noexcept : state(s) {
+        // Must precede all owner dereferences and temporary writes, independently
+        // of the worker's request validation. No native write is reachable today.
+        if (!HasVerifiedPoseWriteContract) return;
+        if (!owner || depth != 1 || state.mutationLock.test_and_set(std::memory_order_acquire)) return;
+        locked = true;
+        if (state.requestLock.test_and_set(std::memory_order_acquire)) return;
+        auto request = state.request;
+        state.requestLock.clear(std::memory_order_release);
+        if (request.owner != reinterpret_cast<std::uintptr_t>(owner) ||
+            request.thread != GetCurrentThreadId() || request.dx == 0.0f) return;
+        LARGE_INTEGER now {};
+        if (!QueryPerformanceCounter(&now) || now.QuadPart >= request.expiresQpc) return;
+        // Offset is only supported by the static trace pinned to ExpectedHash;
+        // this pointer is never inferred from the FOV instance.
+        field = reinterpret_cast<std::byte*>(owner) + 0x64;
+        std::memcpy(&oldX, field, sizeof(oldX));
+        const float newX = oldX + request.dx;
+        if (!std::isfinite(oldX) || !std::isfinite(newX)) { field = nullptr; return; }
+        std::memcpy(field, &newX, sizeof(newX));
+        patched = true;
+        state.applyCount.fetch_add(1, std::memory_order_relaxed);
+    }
+    ~ScopedPoseExperiment() noexcept {
+        if (patched) std::memcpy(field, &oldX, sizeof(oldX));
+        if (locked) state.mutationLock.clear(std::memory_order_release);
+    }
+    ScopedPoseExperiment(const ScopedPoseExperiment&) = delete;
+    ScopedPoseExperiment& operator=(const ScopedPoseExperiment&) = delete;
+};
+
+// Text request deliberately requires a PID, QPC session start, exact owner and
+// thread from THIS process's observer log. Format:
+// GCTPOSE1 <pid> <start_qpc> <owner_hex> <thread_id> <x_delta>
+// e.g. GCTPOSE1 1234 987654321 0x12340000 5678 0.25
+// A new file modification grants at most a five-second window, never persistent.
+void ReadPoseExperiment(detail::PoseObserverState& s, LONGLONG now) {
+    const auto path = util::GetCurrentModuleFilePath().parent_path() / "pose_experiment_request.txt";
+    std::error_code error;
+    const auto time = std::filesystem::last_write_time(path, error);
+    if (error) {
+        s.sawRequestFile = false;
+        // Removing the opt-in request stops any pending experiment promptly.
+        while (s.requestLock.test_and_set(std::memory_order_acquire)) std::this_thread::yield();
+        s.request = {};
+        s.requestLock.clear(std::memory_order_release);
+        return;
+    }
+    if (s.sawRequestFile && time == s.requestFileTime) return;
+    s.sawRequestFile = true;
+    s.requestFileTime = time;
+    // A malformed edit MUST revoke the previous request, not leave it active.
+    while (s.requestLock.test_and_set(std::memory_order_acquire)) std::this_thread::yield();
+    s.request = {};
+    s.requestLock.clear(std::memory_order_release);
+    if (!HasVerifiedPoseWriteContract) {
+        s.log << "{\"event\":\"experiment_rejected\",\"reason\":\"camera_identity_unverified\","
+            "\"callback_order_verified\":false,\"pose_frame_verified\":false}\n";
+        return;
+    }
+    std::ifstream in(path);
+    std::string magic, ownerText, extra;
+    unsigned long long start = 0;
+    unsigned long long pid = 0, thread = 0;
+    float dx = 0;
+    if (!(in >> magic >> pid >> start >> ownerText >> thread >> dx) ||
+        (in >> extra) || magic != "GCTPOSE1" ||
+        pid != GetCurrentProcessId() ||
+        start != static_cast<unsigned long long>(s.started) ||
+        thread == 0 || thread > 0xFFFFFFFFull ||
+        !std::isfinite(dx) || dx < -0.5f || dx > 0.5f || dx == 0.0f) {
+        s.log << "{\"event\":\"experiment_rejected\",\"reason\":\"invalid_request_or_session\"}\n";
+        return;
+    }
+    std::size_t parsed = 0;
+    std::uintptr_t owner = 0;
+    try { owner = static_cast<std::uintptr_t>(std::stoull(ownerText, &parsed, 16)); }
+    catch (...) { parsed = 0; }
+    if (!owner || parsed != ownerText.size() || ownerText.rfind("0x", 0) != 0) {
+        s.log << "{\"event\":\"experiment_rejected\",\"reason\":\"owner_parse\"}\n";
+        return;
+    }
+    // Require the candidate to have been observed recently by this detour.
+    bool observed = false;
+    while (s.samplesLock.test_and_set(std::memory_order_acquire)) std::this_thread::yield();
+    for (const auto& entry : s.entries) {
+        if (entry.owner == owner && entry.thread == thread && entry.count >= 5 &&
+            entry.last <= now && now - entry.last < s.frequency * 2) observed = true;
+    }
+    s.samplesLock.clear(std::memory_order_release);
+    if (!observed) {
+        s.log << "{\"event\":\"experiment_rejected\",\"reason\":\"owner_not_recently_observed\"}\n";
+        return;
+    }
+    while (s.requestLock.test_and_set(std::memory_order_acquire)) std::this_thread::yield();
+    s.request = {owner, static_cast<DWORD>(thread), dx, now + s.frequency * 5};
+    s.requestLock.clear(std::memory_order_release);
+    s.log << "{\"event\":\"experiment_armed\",\"duration_seconds\":5,\"render_camera_verified\":false,\"owner\":\"0x"
+        << std::hex << owner << std::dec << "\",\"thread_id\":" << thread << ",\"x_delta\":" << dx << "}\n";
+}
+#endif
+
+// The void(owner) signature is constrained by static x64 register flow, not live proof.
+// Exactly one original call, outside diagnostic locks; no catch/retry of original.
+void ObserveApplyPose(void* owner) {
+    const DWORD lastError = GetLastError();
+    auto* state = observer.load(std::memory_order_acquire);
+    struct Depth final {
+        Depth() { ++callbackDepth; }
+        ~Depth() { --callbackDepth; }
+    } depth;
+    TargetTrace trace;
+    trace.owner = reinterpret_cast<std::uintptr_t>(owner);
+    struct TraceScope final {
+        TargetTrace* previous;
+        explicit TraceScope(TargetTrace& value) : previous(currentTrace) { currentTrace = &value; }
+        ~TraceScope() { currentTrace = previous; }
+    } traceScope(trace);
+    LARGE_INTEGER start {};
+    QueryPerformanceCounter(&start);
+    trace.start = start.QuadPart;
+    Record(*state, owner, callbackDepth);
+#if defined(GCT_NATIVE_POSE_EXPERIMENT)
+    ScopedPoseExperiment experiment(*state, owner, callbackDepth);
+#endif
+    // Preserve caller's last-error state even when experimental checks called Win32.
+    SetLastError(lastError);
+    state->original(owner);
+    const DWORD originalLastError = GetLastError();
+    LARGE_INTEGER end {};
+    QueryPerformanceCounter(&end);
+    trace.end = end.QuadPart;
+    RecordCompletion(*state, owner, trace);
+    SetLastError(originalLastError);
+}
+
+void Flush(detail::PoseObserverState& state, LONGLONG now) {
+    std::array<Entry, 64> entries;
+    std::uint64_t capacityDrops;
+    // Only the plugin worker waits. Copy then release before formatting/file I/O.
+    while (state.samplesLock.test_and_set(std::memory_order_acquire)) std::this_thread::yield();
+    entries = state.entries;
+    capacityDrops = state.capacityDrops;
+    state.samplesLock.clear(std::memory_order_release);
+    const auto total = state.calls.load(std::memory_order_relaxed);
+    const double seconds = static_cast<double>(now - state.lastFlush) / state.frequency;
+#if defined(GCT_NATIVE_POSE_EXPERIMENT)
+    ReadPoseExperiment(state, now);
+#endif
+    state.log << "{\"event\":\"samples\",\"qpc\":" << now
+        << ",\"calls\":" << total << ",\"window_seconds\":" << seconds
+        << ",\"calls_per_second\":" << static_cast<double>(total - state.lastCalls) / seconds
+        << ",\"contention_drops\":" << state.contentionDrops.load(std::memory_order_relaxed)
+        << ",\"capacity_drops\":" << capacityDrops
+#if defined(GCT_NATIVE_POSE_EXPERIMENT)
+        << ",\"experiment_apply_count\":" << state.applyCount.load(std::memory_order_relaxed)
+#endif
+        << ",\"owners\":[";
+    bool first = true;
+    for (const auto& entry : entries) {
+        if (entry.count == 0) continue;
+        if (!first) state.log << ',';
+        first = false;
+        state.log << "{\"owner\":\"0x" << std::hex << entry.owner << std::dec
+            << "\",\"thread_id\":" << entry.thread << ",\"recorded_calls\":" << entry.count
+            << ",\"first_qpc\":" << entry.first << ",\"last_qpc\":" << entry.last
+            << ",\"max_depth\":" << entry.maxDepth
+            << ",\"completed_calls\":" << entry.completedCalls;
+        const auto& t = entry.trace;
+        state.log << ",\"last_completed_apply\":{\"start_qpc\":" << t.start << ",\"end_qpc\":" << t.end
+            << ",\"position_target\":\"0x" << std::hex << t.positionTarget
+            << "\",\"rotation_target\":\"0x" << t.rotationTarget
+            << "\",\"camera_flags_target\":\"0x" << t.cameraTarget << std::dec
+            << "\",\"position_calls\":" << t.positionCalls << ",\"rotation_calls\":" << t.rotationCalls
+            << ",\"camera_flags_calls\":" << t.cameraCalls
+            << ",\"position_order\":" << t.positionOrder << ",\"rotation_order\":" << t.rotationOrder
+            << ",\"camera_flags_order\":" << t.cameraOrder;
+        const bool finite = std::isfinite(t.position[0]) && std::isfinite(t.position[1]) && std::isfinite(t.position[2])
+            && std::isfinite(t.rotation[0]) && std::isfinite(t.rotation[1]) && std::isfinite(t.rotation[2]) && std::isfinite(t.rotation[3]);
+        state.log << ",\"values_finite\":" << (finite ? "true" : "false");
+        if (finite) state.log << ",\"position_candidate\":[" << t.position[0] << ',' << t.position[1] << ',' << t.position[2]
+            << "],\"rotation_candidate\":[" << t.rotation[0] << ',' << t.rotation[1] << ',' << t.rotation[2] << ',' << t.rotation[3] << ']';
+        state.log << "}}";
+    }
+    state.log << "]}\n";
+    state.log.flush();
+    state.lastCalls = total;
+    state.lastFlush = now;
+}
+} // namespace
+
+void NativePoseHook::Start() noexcept {
+    if (state_) return;
+    try {
+        // Intentionally retained until process exit, including failed-start state.
+        // Never free an enabled trampoline while game callbacks could be in flight.
+        state_ = new detail::PoseObserverState;
+        state_->log.exceptions(std::ios::badbit | std::ios::failbit);
+        state_->log.open(util::GetCurrentModuleFilePath().parent_path() / "pose_observer.jsonl", std::ios::app);
+        state_->log.imbue(std::locale::classic());
+        state_->log << std::setprecision(10);
+        const auto [module, region] = GetGameModuleContext();
+        if (region != GameRegion::OS) throw std::runtime_error("unsupported_region");
+        std::wstring path(32768, L'\0');
+        const DWORD size = GetModuleFileNameW(module, path.data(), static_cast<DWORD>(path.size()));
+        if (!size || size >= path.size()) throw std::runtime_error("module_path_failed");
+        path.resize(size);
+        if (HashFile(path) != ExpectedHash) throw std::runtime_error("binary_hash_mismatch");
+        auto* target = reinterpret_cast<unsigned char*>(module) + ApplyRva;
+        if (std::memcmp(target, EntryBytes.data(), EntryBytes.size()) != 0)
+            throw std::runtime_error("entry_bytes_mismatch");
+        constexpr std::array<unsigned char, 14> setterBytes {
+            0x48, 0x89, 0x5c, 0x24, 0x08, 0x57, 0x48, 0x83, 0xec, 0x20, 0x48, 0x8b, 0xfa, 0x48
+        };
+        constexpr std::array<unsigned char, 14> flagsBytes {
+            0x40, 0x53, 0x48, 0x83, 0xec, 0x20, 0x48, 0x8b, 0xd9, 0x48, 0x85, 0xc9, 0x74, 0x17
+        };
+        auto* base = reinterpret_cast<unsigned char*>(module);
+        if (std::memcmp(base + 0x1435d50, setterBytes.data(), setterBytes.size()) != 0 ||
+            std::memcmp(base + 0x1436190, setterBytes.data(), setterBytes.size()) != 0 ||
+            std::memcmp(base + 0x1456b30, flagsBytes.data(), flagsBytes.size()) != 0)
+            throw std::runtime_error("target_trace_entry_mismatch");
+        LARGE_INTEGER frequency {}, now {};
+        if (!QueryPerformanceFrequency(&frequency) || frequency.QuadPart <= 0 || !QueryPerformanceCounter(&now))
+            throw std::runtime_error("clock_unavailable");
+        state_->frequency = frequency.QuadPart;
+        state_->started = state_->lastFlush = now.QuadPart;
+#if defined(GCT_NATIVE_ARGUMENT_TRIAL)
+        state_->argumentTrial.Initialize(util::GetCurrentModuleFilePath().parent_path(), now.QuadPart, frequency.QuadPart);
+#endif
+        state_->hook = mmh::Hook<void, void*>::Create(target, reinterpret_cast<void*>(ObserveApplyPose));
+        state_->original = reinterpret_cast<void (*)(void*)>(state_->hook.GetOriginal());
+        if (!state_->original) throw std::runtime_error("trampoline_missing");
+        state_->positionHook = mmh::Hook<void, void*, const void*>::Create(base + 0x1435d50, reinterpret_cast<void*>(ObservePosition));
+        state_->rotationHook = mmh::Hook<void, void*, const void*>::Create(base + 0x1436190, reinterpret_cast<void*>(ObserveRotation));
+        state_->cameraFlagsHook = mmh::Hook<void, void*>::Create(base + 0x1456b30, reinterpret_cast<void*>(ObserveCameraFlags));
+        state_->positionOriginal = reinterpret_cast<void (*)(void*, const void*)>(state_->positionHook.GetOriginal());
+        state_->rotationOriginal = reinterpret_cast<void (*)(void*, const void*)>(state_->rotationHook.GetOriginal());
+        state_->cameraFlagsOriginal = reinterpret_cast<void (*)(void*)>(state_->cameraFlagsHook.GetOriginal());
+        if (!state_->positionOriginal || !state_->rotationOriginal || !state_->cameraFlagsOriginal)
+            throw std::runtime_error("target_trace_trampoline_missing");
+        HMODULE pinned = nullptr;
+        if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                reinterpret_cast<LPCWSTR>(ObserveApplyPose), &pinned)) throw std::runtime_error("module_pin_failed");
+        state_->log << "{\"event\":\"validated\",\"mode\":\""
+#if defined(GCT_NATIVE_POSE_EXPERIMENT)
+            << "experiment_blocked"
+#else
+            << "observe_only"
+#endif
+            << "\",\"trace_schema\":2,\"target_trace\":true,\"pid\":" << GetCurrentProcessId()
+            << ",\"worker_thread_id\":" << GetCurrentThreadId() << ",\"rva\":\"0x6CFD1B0\",\"sha256\":\"" << ExpectedHash
+            << "\",\"qpc_frequency\":" << state_->frequency << ",\"start_qpc\":" << state_->started
+            << ",\"camera_identity_verified\":false,\"pose_write_contract_verified\":"
+            << (HasVerifiedPoseWriteContract ? "true" : "false")
+            << ",\"pose_writes\":false,\"hot_unload_supported\":false}\n";
+#if defined(GCT_NATIVE_ARGUMENT_TRIAL)
+        state_->log << "{\"event\":\"persistent_pose_available\",\"requires_explicit_session_request\":true,"
+            "\"keyboard_movement\":true,\"duration_seconds\":null,\"source_pose_writes\":false,\"render_camera_verified\":false}\n";
+#endif
+        state_->log.flush();
+        observer.store(state_, std::memory_order_release);
+        state_->positionHook.Enable(true);
+        state_->rotationHook.Enable(true);
+        state_->cameraFlagsHook.Enable(true);
+        state_->hook.Enable(true);
+        state_->observing = true;
+        state_->log << "{\"event\":\"hook_enabled\",\"runtime_abi_verified\":false}\n";
+        state_->log.flush();
+    } catch (const std::exception& error) {
+        // Diagnostic setup must not abort the existing FOV/FPS components.
+        // Do not expose arbitrary exception text as JSON (it may contain quotes).
+        OutputDebugStringA("GCT pose observer setup failed; live status remains unverified.\n");
+        try {
+            if (state_ && state_->log.is_open()) {
+                // Reasons from our guards are fixed tokens; library exceptions are generic.
+                const std::string reason = error.what();
+                const bool token = !reason.empty() && reason.find_first_not_of("abcdefghijklmnopqrstuvwxyz_") == std::string::npos;
+                state_->log << "{\"event\":\"setup_failed\",\"reason\":\"" << (token ? reason : "setup_exception") << "\"}\n";
+                state_->log.flush();
+            }
+        } catch (...) { if (state_) state_->logFailed = true; }
+    } catch (...) {
+        OutputDebugStringA("GCT pose observer setup failed with unknown exception.\n");
+    }
+}
+
+void NativePoseHook::Update() noexcept {
+    if (!state_ || !state_->observing || state_->logFailed) return;
+    LARGE_INTEGER now {};
+    if (!QueryPerformanceCounter(&now)) return;
+#if defined(GCT_NATIVE_ARGUMENT_TRIAL)
+    if (now.QuadPart - state_->lastTrialPoll >= state_->frequency / 10) {
+        const auto ioFailed = [&](int code) noexcept {
+            state_->argumentTrial.IoFailed();
+            ++state_->trialIoFailures;
+            if (!state_->lastTrialIoLog || now.QuadPart - state_->lastTrialIoLog >= state_->frequency) {
+                try {
+                    state_->log << "{\"event\":\"argument_trial_io_failed\",\"error_code\":" << code
+                        << ",\"failures\":" << state_->trialIoFailures << ",\"qpc\":" << now.QuadPart << "}\n";
+                    state_->log.flush();
+                } catch (...) { }
+                state_->lastTrialIoLog = now.QuadPart;
+            }
+            state_->lastTrialPoll = now.QuadPart;
+        };
+        try {
+            std::array<TrialBinding, 64> bindings {};
+            while (state_->samplesLock.test_and_set(std::memory_order_acquire)) std::this_thread::yield();
+            for (std::size_t i = 0; i < state_->entries.size(); ++i) {
+                const auto& entry = state_->entries[i];
+                const auto& t = entry.trace;
+                const bool valid = entry.completedCalls >= 5 && entry.maxDepth == 1 &&
+                    std::all_of(t.position.begin(), t.position.end(), [](float v) { return std::isfinite(v); }) && t.positionTarget &&
+                    t.positionTarget == t.rotationTarget && t.cameraTarget && t.positionCalls == 1 &&
+                    t.rotationCalls == 1 && t.cameraCalls == 1 && t.positionOrder == 1 && t.rotationOrder == 2 && t.cameraOrder == 3;
+                bindings[i] = {entry.owner, t.positionTarget, t.cameraTarget, entry.thread, t.end, valid, t.position};
+            }
+            state_->samplesLock.clear(std::memory_order_release);
+            state_->argumentTrial.Poll(bindings, now.QuadPart);
+            state_->lastTrialPoll = now.QuadPart;
+        } catch (const std::system_error& error) { ioFailed(error.code().value()); }
+        catch (...) { ioFailed(static_cast<int>(GetLastError())); }
+    }
+#endif
+    if (now.QuadPart - state_->lastFlush < state_->frequency) return;
+    try { Flush(*state_, now.QuadPart); }
+    catch (...) {
+        state_->logFailed = true;
+        OutputDebugStringA("GCT pose observer log failed; original forwarding remains active.\n");
+    }
+}
+} // namespace z3lx::plugin::camera
+
+#endif // GCT_NATIVE_POSE_OBSERVER
diff --git a/tests/freecam_core_tests.cpp b/tests/freecam_core_tests.cpp
new file mode 100644
index 0000000..07d5f28
--- /dev/null
+++ b/tests/freecam_core_tests.cpp
@@ -0,0 +1,161 @@
+#include "plugin/camera/FreeCamCore.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <thread>
+
+using namespace z3lx::plugin::camera;
+
+#define CHECK(x) do { if (!(x)) { \
+    std::fprintf(stderr, "FAIL %s at line %d\n", #x, __LINE__); return false; \
+} } while (0)
+
+bool Near(float a, float b, float eps = 1e-3f) { return std::fabs(a-b) < eps; }
+
+struct FakeCamera final : IFrameCamera {
+    CameraPose gameplay {};
+    CameraPose rendered {};
+    bool renderThread = true;
+    bool canBegin = true;
+    bool canApply = true;
+    bool canRestore = true;
+    bool detached = false;
+    int beginCalls = 0;
+    int applyCalls = 0;
+    int restoreCalls = 0;
+
+    bool IsOnRenderThread() const noexcept override { return renderThread; }
+    bool Begin(CameraPose& out) noexcept override {
+        ++beginCalls;
+        if (!canBegin) return false;
+        detached = true;
+        rendered = gameplay;
+        out = rendered;
+        return true;
+    }
+    bool Apply(const CameraPose& next) noexcept override {
+        ++applyCalls;
+        if (!detached || !canApply) return false;
+        rendered = next;
+        return true;
+    }
+    bool Restore() noexcept override {
+        ++restoreCalls;
+        if (!canRestore) return false;
+        rendered = gameplay;
+        detached = false;
+        return true;
+    }
+};
+
+bool TestStartMoveStop() {
+    FakeCamera camera;
+    camera.gameplay.position = {10.f, 20.f, 30.f};
+    FreeCamCore core(Settings {6.f, 90.f, 4.f, 0.25f});
+    CHECK(core.Start(camera) == Result::Ok);
+    CHECK(core.Start(camera) == Result::AlreadyEnabled);
+    CHECK(core.Tick(Input {.forward = 1.f}, 0.25f) == Result::Ok);
+    CHECK(Near(camera.rendered.position.z, 31.5f));
+    CHECK(Near(camera.rendered.position.x, 10.f));
+    CHECK(core.ResetPose() == Result::Ok);
+    CHECK(Near(camera.rendered.position.z, 30.f));
+    CHECK(core.Stop() == Result::Ok);
+    CHECK(!core.Active() && !camera.detached);
+    CHECK(Near(camera.rendered.position.z, 30.f));
+    CHECK(camera.restoreCalls == 1);
+    return true;
+}
+
+bool TestYawMove() {
+    FakeCamera camera;
+    FreeCamCore core(Settings {4.f, 360.f, 4.f, 0.25f});
+    CHECK(core.Start(camera) == Result::Ok);
+    CHECK(core.Tick(Input {.forward=1.f, .yaw=1.f}, 0.25f) == Result::Ok);
+    CHECK(Near(camera.rendered.position.x, 1.f));
+    CHECK(Near(camera.rendered.position.z, 0.f));
+    CHECK(core.Stop() == Result::Ok);
+    return true;
+}
+
+bool TestNormalizeMovement() {
+    FakeCamera camera;
+    FreeCamCore core(Settings {4.f, 90.f, 4.f, 0.25f});
+    CHECK(core.Start(camera) == Result::Ok);
+    CHECK(core.Tick(Input {.right = 1.f, .forward = 1.f}, 0.25f) == Result::Ok);
+    const auto p = camera.rendered.position;
+    CHECK(Near(std::sqrt(p.x*p.x + p.z*p.z), 1.f));
+    CHECK(core.Stop() == Result::Ok);
+    return true;
+}
+
+bool TestErrorHandling() {
+    FakeCamera camera;
+    FreeCamCore core;
+    CHECK(core.Tick({}, .1f) == Result::NotEnabled);
+    camera.renderThread = false;
+    CHECK(core.Start(camera) == Result::WrongThread);
+    camera.renderThread = true;
+    camera.canBegin = false;
+    CHECK(core.Start(camera) == Result::BackendUnavailable);
+    camera.canBegin = true;
+    CHECK(core.Start(camera) == Result::Ok);
+    int before = camera.applyCalls;
+    CHECK(core.Tick({}, 0.0f) == Result::InvalidInput);
+    CHECK(core.Tick({}, 1.0f) == Result::InvalidInput);
+    CHECK(camera.applyCalls == before);
+    camera.canApply = false;
+    CHECK(core.Tick({}, .1f) == Result::ApplyFailed);
+    CHECK(!core.Active() && !camera.detached);
+    return true;
+}
+
+bool TestFailedRestoreRetry() {
+    FakeCamera camera;
+    FreeCamCore core;
+    CHECK(core.Start(camera) == Result::Ok);
+    camera.canRestore = false;
+    CHECK(core.Stop() == Result::RestoreFailed);
+    CHECK(core.Active());
+    CHECK(core.Tick({}, .1f) == Result::RestoreFailed);
+    camera.canRestore = true;
+    CHECK(core.Stop() == Result::Ok);
+    CHECK(!core.Active() && !camera.detached);
+    return true;
+}
+
+bool TestInvalidInitialPose() {
+    FakeCamera camera;
+    camera.gameplay.rotation = {0,0,0,0};
+    FreeCamCore core;
+    CHECK(core.Start(camera) == Result::InvalidPose);
+    CHECK(!core.Active() && !camera.detached);
+    CHECK(camera.restoreCalls == 1);
+    return true;
+}
+
+bool TestThreadEnforcement() {
+    FakeCamera camera;
+    FreeCamCore core;
+    CHECK(core.Start(camera) == Result::Ok);
+    Result tick = Result::Ok;
+    Result stop = Result::Ok;
+    std::thread t([&] {
+        tick = core.Tick(Input{.forward=1.f}, 0.1f);
+        stop = core.Stop();
+    });
+    t.join();
+    CHECK(tick == Result::WrongThread);
+    CHECK(stop == Result::WrongThread);
+    CHECK(camera.applyCalls == 0);
+    CHECK(core.Stop() == Result::Ok);
+    return true;
+}
+
+int main() {
+    const bool ok = TestStartMoveStop() && TestYawMove() &&
+        TestNormalizeMovement() && TestErrorHandling() &&
+        TestFailedRestoreRetry() && TestInvalidInitialPose() &&
+        TestThreadEnforcement();
+    if (!ok) return 1;
+    std::puts("FreeCam core tests: 7/7 PASS (FAKE camera only; NO Genshin live claim)");
+}
