diff --git a/include/plugin/camera/FreeCamCore.hpp b/include/plugin/camera/FreeCamCore.hpp
new file mode 100644
index 0000000..5556d64
--- /dev/null
+++ b/include/plugin/camera/FreeCamCore.hpp
@@ -0,0 +1,95 @@
+#pragma once
+
+// GCT FreeCam motion/state core. No Genshin offsets, DLL loading, hooks, or Unity API.
+// This code MUST only be called by a verified render/main-thread backend.
+// The IFrameCamera implementation owns game-camera detach, input ownership,
+// projection/pose writes, world shifts, and COMPLETE restore.
+
+#include <thread>
+
+namespace z3lx::plugin::camera {
+
+struct Vec3 { float x = 0, y = 0, z = 0; };
+struct Quaternion { float w = 1, x = 0, y = 0, z = 0; };
+struct CameraPose {
+    Vec3 position {};
+    Quaternion rotation {};
+};
+
+struct Input {
+    // All movement axes range from -1 to +1, in CAMERA-LOCAL coordinates.
+    float right = 0;
+    float up = 0;
+    float forward = 0;
+    // Look axes are -1..+1; positive yaw turns towards +X from forward +Z.
+    float yaw = 0;
+    float pitch = 0;
+    float roll = 0;
+    bool fast = false;
+    bool slow = false;
+};
+
+struct Settings {
+    float speed = 6.0f;        // scene units per second
+    float turnSpeed = 90.0f;   // degrees per second
+    float fastMultiplier = 4.0f;
+    float slowMultiplier = 0.25f;
+};
+
+enum class Result {
+    Ok,
+    AlreadyEnabled,
+    NotEnabled,
+    BackendUnavailable,
+    InvalidPose,
+    InvalidInput,
+    WrongThread,
+    ApplyFailed,
+    RestoreFailed
+};
+
+class IFrameCamera {
+public:
+    virtual ~IFrameCamera() = default;
+
+    // Strong thread gate; must be based on a VERIFIED native callback.
+    virtual bool IsOnRenderThread() const noexcept = 0;
+    // Acquire verified LIVE main-camera ownership and snapshot all game state.
+    // Do not succeed until the native camera/transform ABI and lifecycle are known.
+    virtual bool Begin(CameraPose& currentPose) noexcept = 0;
+    // Called exclusively from the game's valid render/main-thread callback.
+    // MUST NOT change FOV: original z3lx FOV module retains ownership.
+    virtual bool Apply(const CameraPose& pose) noexcept = 0;
+    // Restore game camera binding, gameplay input, projection and original state.
+    // Must remain retryable on failure. Returning true means restoration confirmed.
+    virtual bool Restore() noexcept = 0;
+};
+
+class FreeCamCore final {
+public:
+    explicit FreeCamCore(Settings settings = {}) noexcept;
+
+    [[nodiscard]] Result Start(IFrameCamera& backend) noexcept;
+    [[nodiscard]] Result Tick(Input input, float deltaSeconds) noexcept;
+    [[nodiscard]] Result ResetPose() noexcept;
+    [[nodiscard]] Result Stop() noexcept;
+
+    [[nodiscard]] bool Active() const noexcept { return active_; }
+    [[nodiscard]] const CameraPose& Pose() const noexcept { return pose_; }
+    [[nodiscard]] Result LastResult() const noexcept { return last_; }
+
+private:
+    [[nodiscard]] bool OnOwnerThread() const noexcept;
+    [[nodiscard]] Result RecoverFromApplyFailure() noexcept;
+
+    Settings settings_ {};
+    CameraPose pose_ {};
+    CameraPose initial_ {};
+    IFrameCamera* backend_ = nullptr;
+    std::thread::id ownerThread_ {};
+    Result last_ = Result::NotEnabled;
+    bool active_ = false;
+    bool restoreOnly_ = false;
+};
+
+} // namespace z3lx::plugin::camera
diff --git a/include/plugin/camera/NativeArgumentTrial.hpp b/include/plugin/camera/NativeArgumentTrial.hpp
new file mode 100644
index 0000000..92099f4
--- /dev/null
+++ b/include/plugin/camera/NativeArgumentTrial.hpp
@@ -0,0 +1,76 @@
+#pragma once
+#if defined(GCT_NATIVE_ARGUMENT_TRIAL)
+#include <Windows.h>
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <filesystem>
+#include <span>
+#include <string>
+
+namespace z3lx::plugin::camera {
+// These are observations, NOT a main-camera identity or lifetime lease.
+struct TrialBinding {
+    std::uintptr_t owner = 0, target = 0, camera = 0;
+    DWORD thread = 0;
+    LONGLONG last = 0;
+    bool valid = false;
+    std::array<float, 3> position {};
+};
+
+// Explicitly authorized visual probe, separate from FreeCamCore's verified
+// takeover contract. Never writes owner/source state, FOV or input; only the
+// selected original pose setter consumes a call-local argument copy.
+class NativeArgumentTrial final {
+public:
+    struct Ticket { std::uint64_t generation = 0; bool replaced = false; };
+    void Initialize(std::filesystem::path directory, LONGLONG session, LONGLONG frequency);
+    void Poll(std::span<const TrialBinding> bindings, LONGLONG now);
+    Ticket Prepare(std::uintptr_t owner, void* target, unsigned depth,
+                   const std::array<float, 3>& source, std::array<float, 3>& copy) noexcept;
+    Ticket PrepareRotation(std::uintptr_t owner, void* target, unsigned depth,
+                   const std::array<float, 4>& source, std::array<float, 4>& copy) noexcept;
+    void Returned(Ticket ticket) noexcept;
+    void IoFailed() noexcept;
+
+private:
+    enum class Phase { Idle, WaitingFocus, Active, Completed, Stopped, Rejected };
+    enum class PositionMode { Axis, Absolute, Offset, Keyboard };
+    struct Control {
+        Phase phase = Phase::Idle;
+        const char* reason = "no_request";
+        std::uint64_t generation = 0, replaced = 0, forwarded = 0;
+        TrialBinding binding {};
+        LONGLONG waitUntil = 0, expires = 0, lastReplaced = 0, lastForwarded = 0;
+        float dx = 0, sourceX = 0, appliedX = 0;
+        unsigned axis = 0;
+        float sourceComponent = 0, appliedComponent = 0;
+        bool hasRotationAnchor = false;
+        std::array<float, 4> rotationAnchor {}, sourceRotation {}, appliedRotation {};
+        PositionMode positionMode = PositionMode::Axis;
+        bool hasPositionTarget = false;
+        std::array<float, 3> requestedPosition {}, positionTarget {}, sourcePosition {}, appliedPosition {};
+        float speed = 3;
+        LONGLONG movementTick = 0;
+        bool hasMovementRotation = false;
+        std::array<float, 4> movementRotation {};
+    } control_;
+    std::atomic_flag lock_ = ATOMIC_FLAG_INIT;
+    std::filesystem::path directory_;
+    LONGLONG session_ = 0, frequency_ = 0;
+    std::string lastCommand_, nonce_;
+    bool hadRequest_ = false;
+    // The owning observer and plugin are retained/pinned until process exit.
+    std::atomic<unsigned> keyboardKeys_ {0};
+    std::atomic<unsigned> keyboardReleaseFirst_ {0};
+    std::atomic<LONGLONG> keyboardLease_ {0};
+    std::atomic<bool> keyboardStop_ {false}, keyboardReady_ {false};
+    bool keyboardStarted_ = false;
+    void StartKeyboard();
+    static LRESULT CALLBACK KeyboardProc(int code, WPARAM message, LPARAM data) noexcept;
+    void Cancel(Phase phase, const char* reason) noexcept;
+    void Command(const std::string& command, std::span<const TrialBinding> bindings, LONGLONG now);
+    void Save(std::span<const TrialBinding> bindings, LONGLONG now);
+};
+}
+#endif
diff --git a/include/plugin/camera/NativePoseHook.hpp b/include/plugin/camera/NativePoseHook.hpp
