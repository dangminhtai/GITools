@@ -0,0 +1,23 @@
+#pragma once
+
+#include "plugin/interfaces/ComponentBase.hpp"
+
+namespace z3lx::plugin::camera {
+namespace detail { struct PoseObserverState; }
+
+// Observer by default. EXPERIMENT requests are rejected until a verified native
+// camera/callback/pose contract exists; the current fork has no such binding.
+// No camera identity or render-thread assertion; FreeCamCore is not connected.
+// GCT_NATIVE_ARGUMENT_TRIAL separately provides an explicitly requested visual
+// probe using a call-local setter-argument copy; it does not verify that contract.
+class NativePoseHook final : public ComponentBase<NativePoseHook> {
+public:
+    void Start() noexcept;
+    void Update() noexcept;
+
+private:
+    // Process-lifetime trampoline storage; the observing DLL is pinned before enable.
+    // Hot unload/reconfiguration is deliberately unsupported.
+    detail::PoseObserverState* state_ = nullptr;
+};
+} // namespace z3lx::plugin::camera
diff --git a/scripts/test-freecam-core.ps1 b/scripts/test-freecam-core.ps1
new file mode 100644
index 0000000..683acae
--- /dev/null
+++ b/scripts/test-freecam-core.ps1
@@ -0,0 +1,21 @@
+# Run in an x64 Native Tools Command Prompt (or PowerShell initialized for MSVC).
+# Compiles only pure FreeCam core/tests; never runs Genshin or a mod loader.
+$ErrorActionPreference = 'Stop'
+$root = (Resolve-Path (Join-Path $PSScriptRoot '..')).Path
+$build = Join-Path $root '.camera-test-build'
+New-Item -ItemType Directory -Force -Path $build | Out-Null
+if (-not (Get-Command cl.exe -ErrorAction SilentlyContinue)) {
+    throw 'MSVC cl.exe not available. Start an x64 Native Tools for VS 2022 terminal.'
+}
+Push-Location $build
+try {
+    & cl.exe /nologo /std:c++20 /EHsc "/I$root\include" `
+        "$root\src\plugin\camera\FreeCamCore.cpp" `
+        "$root\tests\freecam_core_tests.cpp" `
+        /Fe:gct-freecam-tests.exe
+    if ($LASTEXITCODE -ne 0) { throw "Compilation failed ($LASTEXITCODE)" }
+    & '.\gct-freecam-tests.exe'
+    if ($LASTEXITCODE -ne 0) { throw "Tests failed ($LASTEXITCODE)" }
+} finally {
+    Pop-Location
+}
diff --git a/src/plugin/camera/FreeCamCore.cpp b/src/plugin/camera/FreeCamCore.cpp
new file mode 100644
index 0000000..99a55fd
--- /dev/null
+++ b/src/plugin/camera/FreeCamCore.cpp
@@ -0,0 +1,153 @@
+#include "plugin/camera/FreeCamCore.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <numbers>
+
+namespace z3lx::plugin::camera {
+namespace {
+constexpr float pi = std::numbers::pi_v<float>;
+constexpr float eps = 1.e-6f;
+
+bool Finite(float value) noexcept { return std::isfinite(value); }
+bool Finite(Vec3 v) noexcept { return Finite(v.x) && Finite(v.y) && Finite(v.z); }
+bool Finite(Quaternion q) noexcept {
+    return Finite(q.w) && Finite(q.x) && Finite(q.y) && Finite(q.z);
+}
+bool Valid(CameraPose pose) noexcept {
+    auto q = pose.rotation;
+    float len2 = q.w*q.w + q.x*q.x + q.y*q.y + q.z*q.z;
+    return Finite(pose.position) && Finite(q) && len2 > eps;
+}
+
+Vec3 operator+(Vec3 a, Vec3 b) noexcept { return {a.x+b.x, a.y+b.y, a.z+b.z}; }
+Vec3 operator*(Vec3 a, float s) noexcept { return {a.x*s, a.y*s, a.z*s}; }
+
+Quaternion Mul(Quaternion a, Quaternion b) noexcept {
+    return {
+        a.w*b.w - a.x*b.x - a.y*b.y - a.z*b.z,
+        a.w*b.x + a.x*b.w + a.y*b.z - a.z*b.y,
+        a.w*b.y - a.x*b.z + a.y*b.w + a.z*b.x,
+        a.w*b.z + a.x*b.y - a.y*b.x + a.z*b.w
+    };
+}
+Quaternion Normalize(Quaternion q) noexcept {
+    float length = std::sqrt(q.w*q.w + q.x*q.x + q.y*q.y + q.z*q.z);
+    return {q.w/length, q.x/length, q.y/length, q.z/length};
+}
+Quaternion AxisAngle(Vec3 axis, float degrees) noexcept {
+    float half = degrees * pi / 360.f;
+    float s = std::sin(half);
+    return {std::cos(half), axis.x*s, axis.y*s, axis.z*s};
+}
+Vec3 Rotate(Quaternion q, Vec3 v) noexcept {
+    // Normalize quaternion before use. Quaternion->matrix avoids 2 temporaries.
+    float xx=q.x*q.x, yy=q.y*q.y, zz=q.z*q.z;
+    float xy=q.x*q.y, xz=q.x*q.z, yz=q.y*q.z;
+    float wx=q.w*q.x, wy=q.w*q.y, wz=q.w*q.z;
+    return {
+        (1-2*(yy+zz))*v.x + 2*(xy-wz)*v.y + 2*(xz+wy)*v.z,
+        2*(xy+wz)*v.x + (1-2*(xx+zz))*v.y + 2*(yz-wx)*v.z,
+        2*(xz-wy)*v.x + 2*(yz+wx)*v.y + (1-2*(xx+yy))*v.z
+    };
+}
+float ClampAxis(float v) noexcept { return std::clamp(v, -1.f, 1.f); }
+bool ValidInput(Input i, float dt) noexcept {
+    return Finite(dt) && dt > 0.f && dt <= 0.25f &&
+           Finite(i.right) && Finite(i.up) && Finite(i.forward) &&
+           Finite(i.yaw) && Finite(i.pitch) && Finite(i.roll);
+}
+} // namespace
+
+FreeCamCore::FreeCamCore(Settings settings) noexcept : settings_(settings) {
+    if (!Finite(settings_.speed) || settings_.speed <= 0.f) settings_.speed = 6.f;
+    if (!Finite(settings_.turnSpeed) || settings_.turnSpeed <= 0.f) settings_.turnSpeed = 90.f;
+    if (!Finite(settings_.fastMultiplier) || settings_.fastMultiplier < 1.f) settings_.fastMultiplier = 4.f;
+    if (!Finite(settings_.slowMultiplier) || settings_.slowMultiplier <= 0.f || settings_.slowMultiplier > 1.f) settings_.slowMultiplier = .25f;
+}
+
+bool FreeCamCore::OnOwnerThread() const noexcept {
+    return ownerThread_ == std::this_thread::get_id();
+}
+
+Result FreeCamCore::Start(IFrameCamera& backend) noexcept {
+    if (active_) return last_ = Result::AlreadyEnabled;
+    if (!backend.IsOnRenderThread()) return last_ = Result::WrongThread;
+    CameraPose current {};
+    if (!backend.Begin(current)) return last_ = Result::BackendUnavailable;
+    backend_ = &backend;
+    ownerThread_ = std::this_thread::get_id();
+    active_ = true;
+    restoreOnly_ = false;
+    if (!Valid(current)) {
+        // Session was acquired but invalid: restoration is still obligatory.
+        restoreOnly_ = true;
+        if (!backend.Restore()) return last_ = Result::RestoreFailed;
+        backend_ = nullptr; active_ = false; restoreOnly_ = false;
+        return last_ = Result::InvalidPose;
+    }
+    pose_ = initial_ = current;
+    pose_.rotation = Normalize(pose_.rotation);
+    initial_.rotation = pose_.rotation;
+    return last_ = Result::Ok;
+}
+
+Result FreeCamCore::RecoverFromApplyFailure() noexcept {
+    restoreOnly_ = true;
+    if (!backend_->Restore()) return last_ = Result::RestoreFailed;
+    active_ = false;
+    restoreOnly_ = false;
+    backend_ = nullptr;
+    return last_ = Result::ApplyFailed;
+}
+
+Result FreeCamCore::Tick(Input input, float deltaSeconds) noexcept {
+    if (!active_) return last_ = Result::NotEnabled;
+    if (!OnOwnerThread() || !backend_->IsOnRenderThread()) return last_ = Result::WrongThread;
+    if (restoreOnly_) return last_ = Result::RestoreFailed;
+    if (!ValidInput(input, deltaSeconds)) return last_ = Result::InvalidInput;
+
+    float speed = settings_.speed * (input.fast ? settings_.fastMultiplier : 1.f) *
+                  (input.slow ? settings_.slowMultiplier : 1.f);
+    float degrees = settings_.turnSpeed * deltaSeconds;
+    Quaternion rotation = pose_.rotation;
+    rotation = Mul(AxisAngle({0,1,0}, ClampAxis(input.yaw)*degrees), rotation);
+    rotation = Mul(rotation, AxisAngle({1,0,0}, -ClampAxis(input.pitch)*degrees));
+    rotation = Mul(rotation, AxisAngle({0,0,1}, ClampAxis(input.roll)*degrees));
+    rotation = Normalize(rotation);
+
+    Vec3 motion {ClampAxis(input.right), ClampAxis(input.up), ClampAxis(input.forward)};
+    float motionLength = std::sqrt(motion.x*motion.x + motion.y*motion.y + motion.z*motion.z);
+    if (motionLength > 1.f) motion = motion * (1.f / motionLength);
+    CameraPose next = pose_;
+    next.rotation = rotation;
+    next.position = next.position + Rotate(rotation, motion) * (speed * deltaSeconds);
+    // FOV is not part of CameraPose. Existing z3lx FOV logic remains sole owner.
+    if (!Valid(next)) return last_ = Result::InvalidPose;
+    if (!backend_->Apply(next)) return RecoverFromApplyFailure();
+    pose_ = next;
+    return last_ = Result::Ok;
+}
+
+Result FreeCamCore::ResetPose() noexcept {
+    if (!active_) return last_ = Result::NotEnabled;
+    if (!OnOwnerThread() || !backend_->IsOnRenderThread()) return last_ = Result::WrongThread;
+    if (restoreOnly_) return last_ = Result::RestoreFailed;
+    // No fake world-origin compensation: the native backend must handle it.
+    if (!backend_->Apply(initial_)) return RecoverFromApplyFailure();
+    pose_ = initial_;
+    return last_ = Result::Ok;
+}
+
+Result FreeCamCore::Stop() noexcept {
+    if (!active_) return last_ = Result::NotEnabled;
+    if (!OnOwnerThread() || !backend_->IsOnRenderThread()) return last_ = Result::WrongThread;
+    restoreOnly_ = true;
+    if (!backend_->Restore()) return last_ = Result::RestoreFailed;
+    active_ = false;
+    restoreOnly_ = false;
+    backend_ = nullptr;
+    return last_ = Result::Ok;
+}
+
+} // namespace z3lx::plugin::camera
diff --git a/src/plugin/camera/NativeArgumentTrial.cpp b/src/plugin/camera/NativeArgumentTrial.cpp
new file mode 100644
index 0000000..2defc72
--- /dev/null
+++ b/src/plugin/camera/NativeArgumentTrial.cpp
@@ -0,0 +1,458 @@
+#if defined(GCT_NATIVE_ARGUMENT_TRIAL)
+#include "plugin/camera/NativeArgumentTrial.hpp"
+#include <algorithm>
+#include <cmath>
+#include <fstream>
+#include <future>
+#include <iomanip>
+#include <locale>
+#include <sstream>
+#include <stdexcept>
+#include <system_error>
+#include <thread>
+
+namespace z3lx::plugin::camera {
+namespace {
+NativeArgumentTrial* keyboardOwner = nullptr;
+unsigned KeyBit(DWORD key) noexcept {
+    switch (key) {
+    case VK_UP: return 1u << 1;
+    case VK_DOWN: return 1u << 3;
+    case VK_LEFT: return 1u << 5;
+    case VK_RIGHT: return 1u << 7;
+    case VK_PRIOR: return 1u << 8; // Page Up: scene up
+    case VK_NEXT: return 1u << 9;  // Page Down: scene down
+    default: return 0;
+    }
+}
+bool GameFocused() noexcept {
+    DWORD pid = 0;
+    GetWindowThreadProcessId(GetForegroundWindow(), &pid);
+    CURSORINFO cursor {sizeof(CURSORINFO)};
+    return pid == GetCurrentProcessId() && GetCursorInfo(&cursor) && !(cursor.flags & CURSOR_SHOWING);
+}
+void Acquire(std::atomic_flag& flag) noexcept {
+    while (flag.test_and_set(std::memory_order_acquire)) std::this_thread::yield();
+}
+bool Recent(const TrialBinding& b, LONGLONG now, LONGLONG frequency) noexcept {
+    return b.valid && b.owner && b.target && b.camera && b.thread &&
+        b.last <= now && now - b.last < frequency * 2;
+}
+bool FinitePosition(const std::array<float, 3>& value) noexcept {
+    return std::all_of(value.begin(), value.end(), [](float v) { return std::isfinite(v); });
+}
+std::uintptr_t Pointer(const std::string& text) {
+    std::size_t used = 0;
+    const auto value = std::stoull(text, &used, 16);
+    if (!value || used != text.size()) throw std::runtime_error("invalid_pointer");
+    return static_cast<std::uintptr_t>(value);
+}
+}
+
+void NativeArgumentTrial::StartKeyboard() {
+    if (keyboardStarted_) {
+        if (!keyboardReady_.load()) throw std::runtime_error("keyboard_hook_unavailable");
+        return;
+    }
+    keyboardStarted_ = true;
+    auto ready = std::make_shared<std::promise<bool>>();
+    auto result = ready->get_future();
+    std::thread([this, ready] {
+        HMODULE module = nullptr;
+        GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            reinterpret_cast<LPCWSTR>(KeyboardProc), &module);
+        keyboardOwner = this;
+        const auto hook = SetWindowsHookExW(WH_KEYBOARD_LL, KeyboardProc, module, 0);
+        keyboardReady_.store(hook != nullptr);
+        ready->set_value(hook != nullptr);
+        if (!hook) return;
+        MSG message {};
+        while (GetMessageW(&message, nullptr, 0, 0) > 0) {
+            TranslateMessage(&message); DispatchMessageW(&message);
+        }
+        UnhookWindowsHookEx(hook);
+        keyboardReady_.store(false);
+        keyboardKeys_.store(0);
+        keyboardLease_.store(0);
+    }).detach();
+    if (result.wait_for(std::chrono::seconds(2)) != std::future_status::ready || !result.get())
+        throw std::runtime_error("keyboard_hook_unavailable");
+}
+
+LRESULT CALLBACK NativeArgumentTrial::KeyboardProc(int code, WPARAM message, LPARAM data) noexcept {
+    auto* self = keyboardOwner;
+    if (code < 0 || !self) return CallNextHookEx(nullptr, code, message, data);
+    const auto& key = *reinterpret_cast<const KBDLLHOOKSTRUCT*>(data);
+    LARGE_INTEGER now {}; QueryPerformanceCounter(&now);
+    const bool down = message == WM_KEYDOWN || message == WM_SYSKEYDOWN;
+    const bool up = message == WM_KEYUP || message == WM_SYSKEYUP;
+    const bool armed = now.QuadPart < self->keyboardLease_.load();
+    DWORD foreground = 0; GetWindowThreadProcessId(GetForegroundWindow(), &foreground);
+    if (armed && foreground == GetCurrentProcessId() && key.vkCode == VK_F8 && down) {
+        self->keyboardStop_.store(true); self->keyboardLease_.store(0); self->keyboardKeys_.store(0);
+        return 1;
+    }
+    const bool shortcut = (key.flags & LLKHF_ALTDOWN) ||
+        (GetAsyncKeyState(VK_CONTROL) & 0x8000) || (GetAsyncKeyState(VK_LWIN) & 0x8000) ||
+        (GetAsyncKeyState(VK_RWIN) & 0x8000);
+    if (!armed || !GameFocused() || shortcut || key.vkCode == VK_MENU || key.vkCode == VK_LMENU || key.vkCode == VK_RMENU) {
+        self->keyboardKeys_.store(0);
+        return CallNextHookEx(nullptr, code, message, data);
+    }
+    const auto bit = KeyBit(key.vkCode);
+    if (bit && (self->keyboardReleaseFirst_.load() & bit)) {
+        // A key pressed before takeover belongs to gameplay. Forward its release
+        // before accepting a fresh press for camera control (no stuck game key).
+        if (up) self->keyboardReleaseFirst_.fetch_and(~bit);
+        return CallNextHookEx(nullptr, code, message, data);
+    }
+    // No disk IO, logging, blocking locks or engine calls on the input thread.
+    if (bit && !(key.flags & LLKHF_INJECTED) && (down || up)) {
+        if (down) self->keyboardKeys_.fetch_or(bit);
+        else self->keyboardKeys_.fetch_and(~bit);
+        return 1;
+    }
+    return CallNextHookEx(nullptr, code, message, data);
+}
