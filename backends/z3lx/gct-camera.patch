+std::string HashFile(const std::filesystem::path& path) {
+    struct Crypto final {
+        BCRYPT_ALG_HANDLE algorithm = nullptr;
+        BCRYPT_HASH_HANDLE hash = nullptr;
+        ~Crypto() {
+            if (hash) BCryptDestroyHash(hash);
+            if (algorithm) BCryptCloseAlgorithmProvider(algorithm, 0);
+        }
+    } crypto;
+    CheckCrypto(BCryptOpenAlgorithmProvider(&crypto.algorithm, BCRYPT_SHA256_ALGORITHM, nullptr, 0));
+    CheckCrypto(BCryptCreateHash(crypto.algorithm, &crypto.hash, nullptr, 0, nullptr, 0, 0));
+    std::ifstream file(path, std::ios::binary);
+    if (!file) throw std::runtime_error("input_unreadable");
+    std::array<unsigned char, 65536> buffer {};
+    while (file) {
+        file.read(reinterpret_cast<char*>(buffer.data()), buffer.size());
+        const auto count = file.gcount();
+        if (count > 0) CheckCrypto(BCryptHashData(crypto.hash, buffer.data(), static_cast<ULONG>(count), 0));
+    }
+    if (!file.eof() || file.bad()) throw std::runtime_error("input_read_failed");
+    std::array<unsigned char, 32> digest {};
+    CheckCrypto(BCryptFinishHash(crypto.hash, digest.data(), static_cast<ULONG>(digest.size()), 0));
+    constexpr char hex[] = "0123456789ABCDEF";
+    std::string result;
+    result.reserve(64);
+    for (const auto byte : digest) {
+        result += hex[byte >> 4];
+        result += hex[byte & 15];
+    }
+    return result;
+}
+
+// Callback-local data only. No extra engine calls or dereferences of opaque targets.
+struct TargetTrace final {
+    std::uintptr_t owner = 0;
+    std::uintptr_t positionTarget = 0, rotationTarget = 0, cameraTarget = 0;
+    std::array<float, 3> position {};
+    std::array<float, 4> rotation {};
+    unsigned step = 0, positionOrder = 0, rotationOrder = 0, cameraOrder = 0;
+    unsigned positionCalls = 0, rotationCalls = 0, cameraCalls = 0;
+    LONGLONG start = 0, end = 0;
+};
+
+struct Entry final {
+    std::uintptr_t owner = 0;
+    DWORD thread = 0;
+    std::uint64_t count = 0;
+    LONGLONG first = 0;
+    LONGLONG last = 0;
+    unsigned maxDepth = 0;
+    std::uint64_t completedCalls = 0;
+    TargetTrace trace {};
+};
+} // namespace
