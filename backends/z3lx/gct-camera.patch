+void NativeArgumentTrial::Cancel(Phase phase, const char* reason) noexcept {
+    keyboardLease_.store(0); keyboardKeys_.store(0);
+    Acquire(lock_);
+    control_.phase = phase;
+    control_.reason = reason;
+    lock_.clear(std::memory_order_release);
+}
+
+void NativeArgumentTrial::Command(const std::string& command, std::span<const TrialBinding> bindings, LONGLONG now) {
+    Acquire(lock_); const auto previous = control_; lock_.clear(std::memory_order_release);
+    // Every changed command revokes the previous override, even if malformed.
+    Cancel(Phase::Rejected, "invalid_request");
+    std::istringstream in(command);
+    in.imbue(std::locale::classic());
+    std::string magic, extra;
+    unsigned long long pid = 0, session = 0;
+    if (!(in >> magic >> pid >> session) || pid != GetCurrentProcessId() ||
+        session != static_cast<unsigned long long>(session_)) return;
+    if (magic == "GCTARGXSTOP1") {
+        if (in >> extra) return;
+        Cancel(Phase::Stopped, "user_stop");
+        return;
+    }
+    std::string ownerText, targetText, cameraText, nonce;
+    unsigned long long thread = 0;
+    float dx = 0;
+    unsigned axis = 0;
+    const bool absolute = magic == "GCTARGABS2", offset = magic == "GCTARGOFFSET2";
+    const bool keyboard = magic == "GCTARGMOVE2";
+    const bool custom = absolute || offset;
+    float speed = 3;
+    std::array<float, 3> requestedPosition {};
+    if ((!custom && !keyboard && magic != "GCTARGPOSE2") ||
+        !(in >> ownerText >> thread >> targetText >> cameraText >> nonce)) return;
+    if (keyboard) {
+        if (!(in >> speed) || !std::isfinite(speed) || speed <= 0) return;
+        StartKeyboard();
+    } else if (custom) {
+        if (!(in >> requestedPosition[0] >> requestedPosition[1] >> requestedPosition[2]) || !FinitePosition(requestedPosition)) return;
+    } else {
+        if (magic != "GCTARGX1" && !(in >> axis)) return;
+        if (!(in >> dx) || axis > 4 || (magic != "GCTARGPOSE2" && axis > 2) ||
+            !std::isfinite(dx) || dx == 0 || std::abs(dx) > (axis < 3 ? 0.25f : 5.0f)) return;
+    }
+    if ((in >> extra) || thread == 0 || thread > 0xffffffffull || nonce.size() != 32 || nonce == nonce_ ||
+        nonce.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos) return;
+    std::uintptr_t owner = 0, target = 0, camera = 0;
+    try { owner = Pointer(ownerText); target = Pointer(targetText); camera = Pointer(cameraText); }
+    catch (...) { return; }
+    const TrialBinding* match = nullptr;
+    unsigned recentCount = 0;
+    for (const auto& b : bindings) {
+        if (!Recent(b, now, frequency_)) continue;
+        ++recentCount;
+        if (b.owner == owner && b.thread == thread && b.target == target && b.camera == camera) match = &b;
+    }
+    if (!match || recentCount != 1) { Cancel(Phase::Rejected, "binding_not_unique_or_recent"); return; }
+    Acquire(lock_);
+    const auto generation = control_.generation + 1;
+    control_ = {};
+    control_.generation = generation;
+    control_.phase = Phase::Active;
+    control_.reason = "camera_hold_active";
+    control_.binding = *match;
+    control_.dx = dx;
+    control_.axis = axis;
+    control_.positionMode = keyboard ? PositionMode::Keyboard : absolute ? PositionMode::Absolute : offset ? PositionMode::Offset : PositionMode::Axis;
+    control_.speed = speed;
+    if (keyboard) {
+        unsigned releaseFirst = 0;
+        for (const auto key : std::array<int, 6> {VK_UP, VK_DOWN, VK_LEFT, VK_RIGHT, VK_PRIOR, VK_NEXT})
+            if (GetAsyncKeyState(key) & 0x8000) releaseFirst |= KeyBit(key);
+        keyboardReleaseFirst_.store(releaseFirst);
+        keyboardLease_.store(now + frequency_);
+    }
+    if (keyboard && previous.phase == Phase::Active && previous.hasPositionTarget &&
+        previous.binding.owner == match->owner && previous.binding.target == match->target &&
+        previous.binding.camera == match->camera && previous.binding.thread == match->thread && FinitePosition(previous.positionTarget)) {
+        control_.positionTarget = previous.positionTarget;
+        control_.hasPositionTarget = true;
+    }
+    keyboardStop_.store(false);
+    control_.requestedPosition = requestedPosition;
+
+    lock_.clear(std::memory_order_release);
+    nonce_ = nonce;
+}
+
+void NativeArgumentTrial::Poll(std::span<const TrialBinding> bindings, LONGLONG now) {
+    if (keyboardStop_.exchange(false)) Cancel(Phase::Stopped, "keyboard_f8_stop");
+    const auto request = directory_ / "pose_arg_trial_request.txt";
+    std::error_code error;
+    const bool exists = std::filesystem::exists(request, error);
+    if (error) throw std::runtime_error("request_status_failed");
+    if (!exists) {
+        if (hadRequest_) Cancel(Phase::Stopped, "request_removed");
+        hadRequest_ = false;
+        lastCommand_.clear();
+    } else {
+        hadRequest_ = true;
+        const auto size = std::filesystem::file_size(request);
+        if (!size || size > 512) {
+            Cancel(Phase::Rejected, "request_size_invalid");
+            lastCommand_.clear();
+        } else {
+            std::ifstream file(request, std::ios::binary);
+            std::string command(static_cast<std::size_t>(size), '\0');
+            if (!file.read(command.data(), static_cast<std::streamsize>(size))) throw std::runtime_error("request_read_failed");
+            if (command != lastCommand_) { lastCommand_ = command; Command(command, bindings, now); }
+        }
+    }
+    // No focus/timer revocation: background throttling is not camera replacement.
+    // Each actual setter callback validates owner/thread/target before override.
+    Acquire(lock_);
+    const bool capture = control_.phase == Phase::Active && control_.positionMode == PositionMode::Keyboard;
+    lock_.clear(std::memory_order_release);
+    keyboardLease_.store(capture ? now + frequency_ : 0);
+    Save(bindings, now);
+}
+
+NativeArgumentTrial::Ticket NativeArgumentTrial::Prepare(std::uintptr_t owner, void* target, unsigned depth,
+        const std::array<float, 3>& source, std::array<float, 3>& copy) noexcept {
+    if (lock_.test_and_set(std::memory_order_acquire)) return {};
+    auto& c = control_;
+    if (keyboardStop_.load()) { c.phase = Phase::Stopped; c.reason = "keyboard_f8_stop"; }
+    if (c.axis >= 3) { lock_.clear(std::memory_order_release); return {}; }
+    Ticket ticket;
+    if (c.generation && depth == 1 && owner == c.binding.owner && GetCurrentThreadId() == c.binding.thread) {
+        if (reinterpret_cast<std::uintptr_t>(target) != c.binding.target) {
+            c.phase = Phase::Stopped; c.reason = "setter_target_changed";
+        } else {
+            ticket.generation = c.generation;
+            if (c.phase == Phase::Active && c.positionMode == PositionMode::Keyboard) {
+                LARGE_INTEGER tick {}; QueryPerformanceCounter(&tick);
+                if (!keyboardReady_.load() || tick.QuadPart >= keyboardLease_.load()) {
+                    c.phase = Phase::Stopped; c.reason = "keyboard_capture_unavailable";
+                }
+            }
+            if (c.phase == Phase::Active) {
+                if (FinitePosition(source)) {
+                    if (c.positionMode == PositionMode::Axis) {
+                        copy = source; copy[c.axis] += c.dx;
+                        ticket.replaced = FinitePosition(copy);
+                    } else {
+                        if (!c.hasPositionTarget) {
+                            c.positionTarget = c.requestedPosition;
+                            if (c.positionMode == PositionMode::Keyboard) c.positionTarget = source;
+                            if (c.positionMode == PositionMode::Offset)
+                                for (std::size_t i = 0; i < 3; ++i) c.positionTarget[i] += source[i];
+                            c.hasPositionTarget = true;
+                        }
+                        if (c.positionMode == PositionMode::Keyboard) {
+                            LARGE_INTEGER tick {}; QueryPerformanceCounter(&tick);
+                            const double dt = c.movementTick && tick.QuadPart >= c.movementTick
+                                ? (std::min)(0.1, static_cast<double>(tick.QuadPart - c.movementTick) / frequency_) : 0;
+                            c.movementTick = tick.QuadPart;
+                            const bool focused = GameFocused();
+                            if (!focused) keyboardKeys_.store(0);
+                            const unsigned keys = focused && tick.QuadPart < keyboardLease_.load() ? keyboardKeys_.load() : 0;
+                            if (keys && c.hasMovementRotation) {
+                                const float right = static_cast<float>(!!(keys & 0x80)) - static_cast<float>(!!(keys & 0x20));
+                                const float forward = static_cast<float>(!!(keys & 0x02)) - static_cast<float>(!!(keys & 0x08));
+                                const float up = static_cast<float>(!!(keys & 0x100)) - static_cast<float>(!!(keys & 0x200));
+                                const auto& q = c.movementRotation;
+                                // XYZW basis matches the visually tested rotation convention.
+                                const std::array<float, 3> r {1-2*(q[1]*q[1]+q[2]*q[2]), 2*(q[0]*q[1]+q[3]*q[2]), 2*(q[0]*q[2]-q[3]*q[1])};
+                                const std::array<float, 3> f {2*(q[0]*q[2]+q[3]*q[1]), 2*(q[1]*q[2]-q[3]*q[0]), 1-2*(q[0]*q[0]+q[1]*q[1])};
+                                std::array<float, 3> direction {};
+                                float length2 = 0;
+                                for (std::size_t i = 0; i < 3; ++i) {
+                                    direction[i] = right*r[i] + forward*f[i] + (i == 1 ? up : 0);
+                                    length2 += direction[i]*direction[i];
+                                }
+                                if (length2 > 0) {
+                                    const double step = static_cast<double>(c.speed) * dt / std::sqrt(length2);
+                                    for (std::size_t i = 0; i < 3; ++i)
+                                        c.positionTarget[i] = static_cast<float>(c.positionTarget[i] + direction[i] * step);
+                                }
+                            }
+                        }
+                        if (FinitePosition(c.positionTarget)) {
+                            copy = c.positionTarget;
+                            ticket.replaced = true;
+                        } else { c.phase = Phase::Stopped; c.reason = "nonfinite_position_target"; }
+                    }
+                    if (ticket.replaced) {
+                        c.sourcePosition = source; c.appliedPosition = copy;
+                        c.sourceX = source[0]; c.appliedX = copy[0];
+                        c.sourceComponent = source[c.axis]; c.appliedComponent = copy[c.axis];
+                    } else if (c.phase == Phase::Active) { c.phase = Phase::Stopped; c.reason = "nonfinite_pose"; }
+                } else { c.phase = Phase::Stopped; c.reason = "nonfinite_pose"; }
+            }
+        }
+    } else if ((c.phase == Phase::Active || c.phase == Phase::WaitingFocus) && depth == 1) {
+        c.phase = Phase::Stopped; c.reason = "owner_or_thread_changed";
+    }
+    lock_.clear(std::memory_order_release);
+    return ticket;
+}
+
+NativeArgumentTrial::Ticket NativeArgumentTrial::PrepareRotation(std::uintptr_t owner, void* target, unsigned depth,
+        const std::array<float, 4>& source, std::array<float, 4>& copy) noexcept {
+    if (lock_.test_and_set(std::memory_order_acquire)) return {};
+    auto& c = control_;
+    Ticket ticket;
+    if (c.positionMode == PositionMode::Keyboard && c.phase == Phase::Active) {
+        if (depth == 1 && owner == c.binding.owner && GetCurrentThreadId() == c.binding.thread &&
+                reinterpret_cast<std::uintptr_t>(target) == c.binding.target) {
+            float length2 = 0;
+            for (float value : source) length2 += value*value;
+            if (std::isfinite(length2) && length2 >= 0.9f && length2 <= 1.1f) {
+                const float inverse = 1.0f / std::sqrt(length2);
+                for (std::size_t i = 0; i < 4; ++i) c.movementRotation[i] = source[i]*inverse;
+                c.hasMovementRotation = true;
+            } else { c.phase = Phase::Stopped; c.reason = "invalid_movement_rotation"; }
+        } else if (depth == 1) { c.phase = Phase::Stopped; c.reason = "movement_rotation_binding_changed"; }
+        lock_.clear(std::memory_order_release);
+        return {};
+    }
+    if (c.axis < 3) { lock_.clear(std::memory_order_release); return {}; }
+    if (c.generation && depth == 1 && owner == c.binding.owner && GetCurrentThreadId() == c.binding.thread) {
+        if (reinterpret_cast<std::uintptr_t>(target) != c.binding.target) {
+            c.phase = Phase::Stopped; c.reason = "rotation_target_changed";
+        } else {
+            ticket.generation = c.generation;
+            if (c.phase == Phase::Active) {
+                {
+                    float length2 = 0;
+                    for (float component : source) length2 += component * component;
+                    if (!std::isfinite(length2) || length2 < 0.9f || length2 > 1.1f) {
+                        c.phase = Phase::Stopped; c.reason = "rotation_not_unit_quaternion_candidate";
+                    } else {
+                        if (!c.hasRotationAnchor) {
+                            const float inverse = 1.0f / std::sqrt(length2);
+                            for (std::size_t i = 0; i < 4; ++i) c.rotationAnchor[i] = source[i] * inverse;
+                            c.hasRotationAnchor = true;
+                        }
+                        // Explicit XYZW layout hypothesis, to be tested visually.
+                        // Fixed anchor prevents a +5-degree change accumulating every call.
+                        const auto& q = c.rotationAnchor;
+                        const float halfAngle = c.dx * 3.14159265358979323846f / 360.0f;
+                        const float s = std::sin(halfAngle), w = std::cos(halfAngle);
+                        if (c.axis == 3) { // candidate world-Y yaw: delta * anchor
+                            copy = {w*q[0]+s*q[2], w*q[1]+s*q[3], w*q[2]-s*q[0], w*q[3]-s*q[1]};
+                        } else { // candidate local-X pitch: anchor * delta
+                            copy = {w*q[0]+s*q[3], w*q[1]+s*q[2], w*q[2]-s*q[1], w*q[3]-s*q[0]};
+                        }
+                        c.sourceRotation = source; c.appliedRotation = copy;
+                        c.sourceComponent = 0; c.appliedComponent = c.dx;
+                        ticket.replaced = true;
+                    }
+                }
+            }
+        }
+    } else if ((c.phase == Phase::Active || c.phase == Phase::WaitingFocus) && depth == 1) {
+        c.phase = Phase::Stopped; c.reason = "owner_or_thread_changed";
+    }
+    lock_.clear(std::memory_order_release);
+    return ticket;
+}
+
+void NativeArgumentTrial::Returned(Ticket ticket) noexcept {
+    if (!ticket.generation) return;
+    LARGE_INTEGER now {}; QueryPerformanceCounter(&now);
+    if (lock_.test_and_set(std::memory_order_acquire)) return;
+    if (ticket.generation == control_.generation) {
+        if (ticket.replaced) { ++control_.replaced; control_.lastReplaced = now.QuadPart; }
+        else { ++control_.forwarded; control_.lastForwarded = now.QuadPart; }
+    }
+    lock_.clear(std::memory_order_release);
+}
+
+void NativeArgumentTrial::IoFailed() noexcept { Cancel(Phase::Stopped, "ipc_io_failed"); }
+
+void NativeArgumentTrial::Save(std::span<const TrialBinding> bindings, LONGLONG now) {
+    Acquire(lock_); const auto c = control_; lock_.clear(std::memory_order_release);
+    const char* phase = "idle";
+    switch (c.phase) {
+    case Phase::WaitingFocus: phase = "waiting_focus"; break;
+    case Phase::Active: phase = "active"; break;
+    case Phase::Completed: phase = "completed"; break;
+    case Phase::Stopped: phase = "stopped"; break;
+    case Phase::Rejected: phase = "rejected"; break;
+    default: break;
+    }
+    const auto temporary = directory_ / "pose_arg_trial_state.tmp";
+    const auto output = directory_ / "pose_arg_trial_state.json";
+    {
+        std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+        file.exceptions(std::ios::badbit | std::ios::failbit);
+        file.imbue(std::locale::classic()); file << std::setprecision(10);
+        file << "{\"schema_version\":1,\"pid\":" << GetCurrentProcessId() << ",\"start_qpc\":" << session_
+            << ",\"qpc_frequency\":" << frequency_ << ",\"heartbeat_qpc\":" << now
+            << ",\"mode\":\"argument_x_visual_trial\",\"render_camera_verified\":false,\"source_pose_writes\":false"
+            << ",\"supported_axes\":[\"x\",\"y\",\"z\",\"yaw\",\"pitch\"],\"supports_xyz\":true,\"supports_rotation\":true"
+            << ",\"supports_custom_position\":true,\"custom_position_limit\":null,\"supports_persistent_pose\":true"
+            << ",\"supports_keyboard_movement\":true,\"keyboard_hook_ready\":" << (keyboardReady_.load() ? "true" : "false")
+            << ",\"keyboard_speed\":" << c.speed
+            << ",\"phase\":\"" << phase << "\",\"reason\":\"" << c.reason << "\",\"nonce\":\"" << nonce_
+            << "\",\"generation\":" << c.generation << ",\"argument_override_count\":" << c.replaced
+            << ",\"original_argument_count\":" << c.forwarded
+            << ",\"last_override_qpc\":" << c.lastReplaced << ",\"last_original_argument_qpc\":" << c.lastForwarded
+            << ",\"deadline_qpc\":" << c.expires << ",\"source_x\":" << c.sourceX << ",\"applied_x\":" << c.appliedX
+            << ",\"axis\":" << c.axis << ",\"source_component\":" << c.sourceComponent << ",\"applied_component\":" << c.appliedComponent
+            << ",\"argument_kind\":\"" << (c.positionMode == PositionMode::Keyboard ? "keyboard" : c.positionMode != PositionMode::Axis ? "custom_position" : c.axis < 3 ? "position" : "rotation") << "\",\"requested_delta\":" << c.dx
+            << ",\"custom_position_mode\":\"" << (c.positionMode == PositionMode::Absolute ? "absolute" : c.positionMode == PositionMode::Offset ? "offset" : "none") << '"'
+            << ",\"source_position\":[" << c.sourcePosition[0] << ',' << c.sourcePosition[1] << ',' << c.sourcePosition[2]
+            << "],\"applied_position\":[" << c.appliedPosition[0] << ',' << c.appliedPosition[1] << ',' << c.appliedPosition[2] << ']'
+            << ",\"rotation_order_hypothesis\":\"xyzw\",\"rotation_order_verified\":false"
+            << ",\"source_rotation\":[" << c.sourceRotation[0] << ',' << c.sourceRotation[1] << ',' << c.sourceRotation[2] << ',' << c.sourceRotation[3]
+            << "],\"applied_rotation\":[" << c.appliedRotation[0] << ',' << c.appliedRotation[1] << ',' << c.appliedRotation[2] << ',' << c.appliedRotation[3] << ']'
+            << ",\"visual_restore_verified\":false,\"bindings\":[";
+        bool first = true;
+        for (const auto& b : bindings) {
+            if (!Recent(b, now, frequency_)) continue;
+            if (!first) file << ','; first = false;
+            file << "{\"owner\":\"0x" << std::hex << b.owner << "\",\"target\":\"0x" << b.target
+                << "\",\"camera\":\"0x" << b.camera << std::dec << "\",\"thread_id\":" << b.thread
+                << ",\"position\":[" << b.position[0] << ',' << b.position[1] << ',' << b.position[2] << "]}";
+        }
+        file << "]}\n";
+        file.flush();
+        file.close();
+    }
+    // A scanner/reader can briefly hold the destination without DELETE sharing.
+    // Retry only transient Windows sharing/access errors, on the worker thread.
+    // Persistent IPC failures revoke camera control.
+    for (unsigned attempt = 0; ; ++attempt) {
+        if (MoveFileExW(temporary.c_str(), output.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) break;
+        const DWORD error = GetLastError();
+        if (attempt >= 4 || (error != ERROR_SHARING_VIOLATION && error != ERROR_LOCK_VIOLATION && error != ERROR_ACCESS_DENIED))
+            throw std::system_error(static_cast<int>(error), std::system_category(), "state_publish_failed");
+        std::this_thread::sleep_for(std::chrono::milliseconds(10u << attempt));
+    }
+}
+}
